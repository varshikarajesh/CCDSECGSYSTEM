    "ESC_QT_MEASUREMENT": {
      "title": "How to measure the QT interval",
      "organization": "European Society of Cardiology Council on Cardiovascular Genomics",
      "year": 2024,
      "url": "https://www.escardio.org/communities/councils/genomics/scientific-documents-and-publications/cardiogenomics-insights/volume-9/how-to-measure-the-qt-interval/",
      "evidence_type": "professional_measurement_guidance",
      "strength": "high"
