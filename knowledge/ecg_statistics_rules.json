{
  "schema_version": "1.0.0",
  "purpose": "Deterministic ECG statistics and morphology support for the multi-label diagnostic bridge. Rules generate evidence, never a standalone diagnosis.",
  "safety": {
    "authority": "decision_support_only",
    "missing_data_policy": "not_evaluable",
    "unknown_is_negative": false,
    "ood_removed": true,
    "patient_context_required_for_management": true,
    "clinician_confirmation_required": true
  },
  "sources": {
    "ANESTHGUIDE_ECG_2026": {
      "title": "ECG and Heart Rhythm - Basic Interpretation and Common Arrhythmias",
